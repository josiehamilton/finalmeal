{
  "name": "finalmeal",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev --filter=@finalmeal/web --filter=@finalmeal/mobile",
    "bootstrap": "pnpm install && pnpm db:start && pnpm env:local",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:import-cities": "node scripts/import-cities.mjs",
    "db:import-places": "node scripts/import-places.mjs",
    "env:local": "node scripts/write-local-env.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "supabase": "2.121.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "supabase"
    ]
  }
}
